<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Phobos.Application\Phobos.Application.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- One JSON file per phobia, embedded so the API always ships with its catalogue. -->
    <EmbeddedResource Include="..\..\content\phobias\*.json" LogicalName="content/phobias/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
